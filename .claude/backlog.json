{
  "$schema": "https://raw.githubusercontent.com/z5labs/devex/main/plugins/backlog/assets/backlog.schema.json",
  "select": {
    "label": "story",
    "milestone": null,
    "limit": 200,
    "project": {
      "owner": "Zaba505",
      "number": 6,
      "field": "Area",
      "value": null
    }
  },
  "dependencies": {
    "style": "native"
  },
  "verify": [
    "go build ./...",
    "gofmt -l .",
    "go vet ./...",
    "golangci-lint run",
    "go test -race ./..."
  ],
  "merge": {
    "label": "auto-merge",
    "workflow": "auto-merge.yaml"
  },
  "review": {
    "reviewers": ["copilot", "local"],
    "app": {
      "idEnv": "ZABA505_REVIEW_APP_ID",
      "keyEnv": "ZABA505_REVIEW_APP_KEY"
    }
  },
  "worktreeDir": ".claude/worktrees"
}
